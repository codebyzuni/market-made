# Get a free API key at https://console.groq.com/keys
# Leave blank to run MarketMate fully offline using the built-in template engine.
GROQ_API_KEY=

# Any Groq-hosted chat model (see https://console.groq.com/docs/models)
GROQ_MODEL_ID=llama-3.3-70b-versatile

# Optional tuning
GROQ_TIMEOUT_SECONDS=20

# Comma-separated list of allowed origins for CORS. "*" = allow all (fine for a demo project).
ALLOWED_ORIGINS=*
